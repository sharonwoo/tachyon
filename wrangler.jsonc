{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tachyon",
	"compatibility_date": "2026-08-25",
	// Static site only: replays are decoded in the browser (public/js/), so
	// there is no Worker script - no CPU/memory limits to hit.
	"assets": { "directory": "./public/" },
	"routes": [{ "pattern": "tachyon.satki.org", "custom_domain": true }]
}
